# Youth Empowerment Hub — Environment Variables
# Copy this file to .env and fill in your production values

# Server
NODE_ENV=production
PORT=3001

# Security — MUST change these for production!
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d
SESSION_EXPIRY_HOURS=8

# Admin account created on first boot
ADMIN_EMAIL=admin@youthempowermenthub.org
ADMIN_PASSWORD=YourSecurePassword123!

# CORS — set to your production domain
CORS_ORIGIN=https://yourdomain.com

# Cookie
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Database (default: server/db/yeh.db)
# DB_PATH=/path/to/your/yeh.db
