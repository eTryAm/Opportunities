# ==============================================================================
# Youth Empowerment Hub (YEH) — Production Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Web Service Dashboard)
# ------------------------------------------------------------------------------

# Server Environment & Port
NODE_ENV=production
PORT=3001

# Security & JWT Authentication (REQUIRED: set strong random secrets in production!)
JWT_SECRET=generate-a-strong-random-32-character-secret-key-here
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d
SESSION_EXPIRY_HOURS=8

# Initial Admin Account (Seeded on first boot if admins table is empty)
ADMIN_EMAIL=admin@youthempowermenthub.org
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Turso Persistent Database (libSQL)
# Get these from https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-database-auth-token

# Persistent Community Photo Storage (Cloudinary)
# Get these from https://cloudinary.com/ (Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS & Domain Configuration
# Set to your Vercel frontend URL or custom domain (e.g. https://opportunities.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# Cookie Settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# (Optional: Local SQLite path if running locally without Turso)
# DB_PATH=server/db/yeh.db

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Dashboard)
# ------------------------------------------------------------------------------

# Production Backend API Base URL
# Points to your Render Web Service URL (e.g. https://opportunities-api.onrender.com)
VITE_API_BASE_URL=https://your-backend.onrender.com

# (Optional: Override default Google Form URLs for opportunities)
# VITE_COMMUNITY_MEMBER_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
# VITE_VOLUNTEER_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
# VITE_DISTRICT_REPRESENTATIVE_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
# VITE_STATE_REPRESENTATIVE_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
# VITE_CAMPUS_AMBASSADOR_FORM_URL=https://docs.google.com/forms/d/e/.../viewform
